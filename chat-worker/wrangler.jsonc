{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "erics-it-chat",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },

  // Live chat API + WebSockets, served at https://chat.erics-it.com
  "routes": [{ "pattern": "chat.erics-it.com", "custom_domain": true }],

  // Workers AI answers visitors' IT questions
  "ai": { "binding": "AI" },

  // One Durable Object holds every conversation, the live sockets, and login codes
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "ChatHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatHub"] }],

  // Cloudflare Email Service: handoff alerts + admin login codes
  "send_email": [{ "name": "EMAIL" }],

  "vars": {
    "ADMIN_EMAIL": "support@erics-it.com",
    "FROM_EMAIL": "chat@erics-it.com",
    "SITE_ORIGIN": "https://erics-it.com",
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
  }
  // Secret (set with `wrangler secret put SESSION_SECRET`): signs admin login cookies
}
